{
  "name": "privacy-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cyber-Defense Personal Data Privacy Vault - security core, browser extension and shared contracts (Phases 0-4)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/extension/tsconfig.json && tsc -p apps/dashboard/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run scripts/tests/tests/security",
    "demo": "tsx --tsconfig tsconfig.json scripts/demo.ts",
    "ruleset:checksum": "tsx --tsconfig tsconfig.json scripts/ruleset-checksum.ts",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "verify": "npm run typecheck && npm run test && npm run build:extension && npm run build:dashboard && npm run check:secrets",
    "dev:core": "npm run dev --workspace @pv/core",
    "start:core": "npm run start --workspace @pv/core",
    "build:extension": "npm run build --workspace @pv/extension",
    "build:dashboard": "npm run build --workspace @pv/dashboard",
    "db:generate": "npm run db:generate --workspace @pv/core",
    "db:migrate": "npm run db:migrate --workspace @pv/core"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
