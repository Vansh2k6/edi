[TEMPLATE]
# Privacy Vault configuration
# Copy to `.env` for local development. Never commit `.env` (AGENT.md).
# Every variable is validated at process start by packages/schemas/src/config.ts.
# A missing or malformed value stops the process with the field name and no value echo.

NODE_ENV=development
LOG_LEVEL=info
CORE_PORT=8080

# Optional. When unset the core uses its in-memory repository instead of Postgres,
# so the stack runs without Docker (see DEV-02 in the implementation plan).
# DATABASE_URL=postgres://pv:pv@localhost:5432/privacy_vault
DATABASE_URL=

# Optional. When unset domain-intelligence caching falls back to an in-process
# cache with the same freshness semantics (see DEV-03).
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# Key management. `dev-shim` writes the KEK outside the app tree and is refused
# in production; `kms` is a stub until the hardening phase.
KEY_PROVIDER=dev-shim
KEK_REF=dev-only-placeholder

# Force Allow grant signing (W6.5). Optional in development: unset, the core
# uses a source-tree development secret. Required in production - the process
# refuses to start without it - because a known signing key makes every grant
# forgeable.
# GRANT_SECRET=generate-at-least-32-random-bytes-per-deployment

# Dashboard web session (W8.1). SESSION_SECRET signs the httpOnly session
# cookie; DASHBOARD_OWNER_SECRET is the credential the login form checks
# against; DASHBOARD_OWNER_USER_ID names the one owner the dashboard
# represents. All three are optional in development (unset, the core serves
# no dashboard login) and required in production.
# SESSION_SECRET=generate-a-separate-32-byte-secret-per-deployment
# DASHBOARD_OWNER_SECRET=the-owners-login-secret-at-least-32-bytes
# DASHBOARD_OWNER_USER_ID=00000000-0000-4000-8000-000000000000

# Domain-intelligence providers
DOMAIN_INTEL_CACHE_TTL_SECONDS=86400
DOMAIN_INTEL_STALE_AFTER_SECONDS=21600
DOMAIN_PROVIDER_TIMEOUT_MS=800
DOMAIN_PROVIDER_RETRIES=2
DOMAIN_PROVIDER_RATE_LIMIT_PER_MINUTE=60
# DOMAIN_PROVIDER_ENDPOINT=https://reputation.example/api/v1/lookup
# DOMAIN_PROVIDER_TOKEN=dev-only-placeholder
